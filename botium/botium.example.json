{
  "botium": {
    "Capabilities": {
      "PROJECTNAME": "Automated_Chatbot_Testing_Botium",
      "CONTAINERMODE": "simplerest",
      "SIMPLEREST_METHOD": "POST",
      "SIMPLEREST_URL": "https://2yv1z6.api.infobip.com/open-channel/1/messages/inbound",
      "WAITFORBOTTIMEOUT": 30000,
      "SCRIPTING_MATCHING_MODE": "wildcardIgnoreCase",
      "SIMPLEREST_HEADERS_TEMPLATE": {
        "Authorization": "App <INFOBIP_API_KEY>",
        "Content-Type": "application/json"
      },
      "SIMPLEREST_BODY_TEMPLATE": {
        "sender": "{{botium.conversationId}}",
        "destination": "<DESTINATION>",
        "content": {
          "body": {
            "type": "TEXT",
            "text": "{{{msg.messageText}}}"
          }
        },
        "responseWebhook": {
          "url": "<NGROK_URL>"
        }
      },
      "SIMPLEREST_INBOUND_PORT": 1234,
      "SIMPLEREST_INBOUND_ENDPOINT": "/api/botium-webhook",
	    "SIMPLEREST_RESPONSE_HOOK": "inbound-hook.js",
      "SIMPLEREST_INBOUND_SELECTOR_JSONPATH": "$.body.destination",
      "SIMPLEREST_INBOUND_SELECTOR_VALUE": "{{botium.conversationId}}"
    }
  }
}